{
  "kind": "collectionType",
  "collectionName": "faqs",
  "info": {
    "singularName": "faq",
    "pluralName": "faqs",
    "displayName": "FAQ",
    "description": "Questions and answers. Every published one is on the FAQ page; tick pages under Show on to repeat it there too."
  },
  "options": { "draftAndPublish": true },
  "attributes": {
    "question": { "type": "string", "required": true, "maxLength": 200 },
    "answer": { "type": "text", "required": true, "maxLength": 1200 },
    "category": {
      "type": "enumeration",
      "enum": [
        "General",
        "Company setup",
        "Licensing",
        "PRO & visas",
        "Compliance",
        "India"
      ],
      "required": true,
      "default": "General"
    },
    "order": { "type": "integer", "default": 10, "required": true },
    "pages": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::page-seo.page-seo"
    }
  }
}
