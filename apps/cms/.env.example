HOST=0.0.0.0
PORT=1337
# Generate each with: node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Local Postgres from the repo-root docker-compose.yml
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=55432
DATABASE_NAME=sinaispark_cms
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=strapi_local
DATABASE_SSL=false

# Next.js site: cache refresh on publish (see src/lib/revalidate.ts)
WEB_REVALIDATE_URL=http://localhost:3100/api/revalidate/
WEB_REVALIDATE_SECRET=change-me

# The website: preview panel + security headers (see config/admin.ts)
WEB_URL=http://localhost:3100
# The same address, for the admin's "View site" button (built into the admin).
STRAPI_ADMIN_WEB_URL=http://localhost:3100
# Shared with the site's PREVIEW_SECRET.
PREVIEW_SECRET=change-me
