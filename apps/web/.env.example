# Strapi CMS (apps/cms). Create the token with: pnpm --filter cms token:web
CMS_URL=http://localhost:1337
CMS_API_TOKEN=

# Shared with the CMS's WEB_REVALIDATE_SECRET; lets it refresh cached pages.
REVALIDATE_SECRET=

# Resend (optional locally: without a key, emails are logged, not sent).
RESEND_API_KEY=
MAIL_FROM="Sinai Spark Global <hello@sinaispark.com>"
# Comma-separated inboxes that receive new enquiries.
ENQUIRY_NOTIFY_TO=

# Signs the cookie that opens gated research. Any long random string.
READER_COOKIE_SECRET=
# Public base for CMS media when uploads are served from Strapi itself.
CMS_PUBLIC_URL=

# Shared with the CMS's PREVIEW_SECRET; lets "Open preview" show drafts.
PREVIEW_SECRET=

# Website assistant (lib/assistant). Without ASSISTANT_DATABASE_URL the chat
# launcher is hidden. Locally the CMS's Postgres; in production a role that
# can only reach the "assistant" schema (see README).
ASSISTANT_DATABASE_URL=postgres://strapi:strapi_local@127.0.0.1:55432/sinaispark_cms
# Groq free plan key (console.groq.com). Without it the assistant still
# answers from its menu, FAQs and saved answers, but can't generate new ones.
GROQ_API_KEY=
# Optional: answer models in fallback order, and the small-job models.
# ASSISTANT_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,llama-3.3-70b-versatile
# ASSISTANT_FAST_MODELS=llama-3.1-8b-instant,openai/gpt-oss-20b
# Optional: where the embedding model is cached (default .cache/models).
# ASSISTANT_MODEL_CACHE=
# Optional: where the indexer fetches the site's own pages from.
# ASSISTANT_CRAWL_ORIGIN=http://127.0.0.1:3100
