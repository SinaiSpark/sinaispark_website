{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "CMS_URL",
        "CMS_API_TOKEN",
        "REVALIDATE_SECRET",
        "RESEND_API_KEY",
        "MAIL_FROM",
        "ENQUIRY_NOTIFY_TO",
        "CMS_PUBLIC_URL",
        "READER_COOKIE_SECRET",
        "PREVIEW_SECRET",
        "ASSISTANT_DATABASE_URL",
        "GROQ_API_KEY",
        "ASSISTANT_MODELS",
        "ASSISTANT_FAST_MODELS",
        "ASSISTANT_MODEL_CACHE",
        "ASSISTANT_CRAWL_ORIGIN",
        "PORT"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
